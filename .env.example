# ==========================================
# KONFIGURASI BOT DISCORD TICKET
# Ganti nilai di bawah ini dengan ID asli Anda
# ==========================================

# Token Bot Discord (Dapatkan dari Discord Developer Portal)
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# ID Aplikasi Bot (Client ID)
CLIENT_ID=YOUR_CLIENT_ID_HERE

# ID Server Discord Anda
GUILD_ID=YOUR_GUILD_ID_HERE

# ID Kategori tempat channel tiket akan dibuat
TICKET_CATEGORY_ID=YOUR_CATEGORY_ID_HERE

# ID Peran Staff / Admin yang akan di-tag
STAFF_ROLE_ID=YOUR_STAFF_ROLE_ID_HERE

# ID Channel tempat log transkrip tiket akan dikirim
TRANSCRIPT_CHANNEL_ID=YOUR_LOG_CHANNEL_ID_HERE

# ID Channel untuk pesan Selamat Datang (Welcome Message)
WELCOME_CHANNEL_ID=MASUKKAN_ID_CHANNEL_WELCOME

# ID Channel untuk pesan Selamat Jalan (Goodbye Message)
GOODBYE_CHANNEL_ID=MASUKKAN_ID_CHANNEL_GOODBYE
